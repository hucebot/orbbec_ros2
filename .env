# Docker Registry (Optional: Define to tag images for pushing)
# REGISTRY=registry.gitlab.com
# IMAGE_NAME=my_team/orbbec_image

# Network
ROS_DOMAIN_ID=2
# Network Mode (Options: robot, local)
DEPLOYMENT_ENV=local

# Camera Parameters
CAMERA_NAME=orbbec_external
SERIAL_NUMBER=CL8FC310085
DEVICE_NUM=2
COLOR_WIDTH=1280
COLOR_HEIGHT=720
ORDERED_PC=true
COLOR_EXPOSURE=150

# Static Transform Publisher
PUBLISH_TF=true
TF_X=0.0
TF_Y=-0.0
TF_Z=1.8
TF_YAW=3.14159
TF_PITCH=0.0
TF_ROLL=0.0
TF_PARENT_FRAME=opensot/base_link